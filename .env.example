# Copy to .env and fill in. .env is git-ignored.

# Competition API key for the agent.
GLEE_API_KEY=glee_...

# Optional: the language-model advisor in glee/advisor.py, which is off by
# default. With the default GLEE_MAX_NUDGE=0 it only rewrites free-text message
# wording; a nonzero GLEE_MAX_NUDGE also lets it move our bargaining and
# negotiation offers by up to that fraction.
GEMINI_API_KEY=
